CONTAINER_HOME_DIR=/grafana/
EXPERIMENT_NAME=icarus

GRAPHITE_VERSION=1.1.10-5
GRAPHITE_PORT=10081
GRAPHITE_MEMORY_LIMIT=16384m
GRAPHITE_STORAGE_DIR=${CONTAINER_HOME_DIR}/data/graphite
GRAPHITE_CONFIG_DIR=${HOME}/grafana-podman/config/${EXPERIMENT_NAME}

GRAFANA_VERSION=11.3.0
GRAFANA_PORT=10080
GRAFANA_MEMORY_LIMIT=2048m
GRAFANA_DATA_DIR=${CONTAINER_HOME_DIR}/data/grafana

NGINX_VERSION=1.24.0-alpine
NGINX_PORT=10443
NGINX_CONF_DIR=${HOME}/grafana-podman/config/nginx
NGINX_CERTS_DIR=${CONTAINER_HOME_DIR}/data/certs
NGINX_MEMORY_LIMIT=1024m

DOZZLE_VERSION=v8.6.2
DOZZLE_PORT=10085
DOZZLE_MEMORY_LIMIT=256m

BIND_IP=192.168.191.45

CARBON_PICKLE_PORT=2003

LOGS_DIR=${CONTAINER_HOME_DIR}/logs

PODMAN_DATA_DIR=${CONTAINER_HOME_DIR}/podman
