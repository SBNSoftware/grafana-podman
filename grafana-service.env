CONTAINER_HOME_DIR=${HOME}/grafana/
EXPERIMENT_NAME=icarus

GRAPHITE_VERSION=1.1.10-5
GRAPHITE_PORT=8080
GRAPHITE_MEMORY_LIMIT=512m
GRAPHITE_STORAGE_DIR=${CONTAINER_HOME_DIR}/data/graphite
GRAPHITE_CONFIG_DIR=${CONTAINER_HOME_DIR}/grafana-service/config/${EXPERIMENT_NAME}

GRAFANA_VERSION=11.3.0
GRAFANA_PORT=3000
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_DATA_DIR=${CONTAINER_HOME_DIR}/data/grafana

NGINX_VERSION=1.24.0-alpine
NGINX_PORT=1443
NGINX_CONF_DIR=${CONTAINER_HOME_DIR}/grafana-service/config/nginx
NGINX_CERTS_DIR=${CONTAINER_HOME_DIR}/data/certs
NGINX_MEMORY_LIMIT=256m

DOZZLE_VERSION=v8.6.2
DOZZLE_PORT=1180
DOZZLE_MEMORY_LIMIT=256m

BIND_IP=127.0.0.1

CARBON_PICKLE_PORT=2004

LOGS_DIR=${CONTAINER_HOME_DIR}/logs

PODMAN_DATA_DIR=${CONTAINER_HOME_DIR}/podman
PODMAN_SOCK=/run/user/1001/podman/podman.sock

LOG_MAX_SIZE=100m
SYSTEMD_SCRIPTS_DIR=${CONTAINER_HOME_DIR}/grafana-service/scripts
BACKUP_DIR=${CONTAINER_HOME_DIR}/grafana-service/backups
CONFIG_DIR=${CONTAINER_HOME_DIR}/grafana-service/config
SSL_CERTS_DIR=${CONTAINER_HOME_DIR}/data/certs
SSL_DNS_NAMES="grafana.example.com 127.0.0.1"
COMPOSE_FILE=./podman-compose.yml
BASH_ENVIRONMENT_CHECK=./check-bash-env.sh
CA_KEY_PASS=nobody-knows-this-key=
GRAFANA_URL=https://127.0.0.1:11443
GRAFANA_API_KEY=glsa_nobody-knows-this-key
RETRY_COUNT=1
